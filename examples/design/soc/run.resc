mach create "chipsim-firmware"
machine LoadPlatformDescription @platform.repl
sysbus LoadELF @firmware.elf
cpu PC 0
emulation RunFor "0.0001"
sysbus ReadDoubleWord 0x10000000
sysbus ReadDoubleWord 0x10000004
python "import json, os; bus=monitor.Machine.SystemBus; f=open(os.path.join(os.environ['CHIPSIM_TASK_WORKSPACE'],'out','mmio.json'),'w'); json.dump(dict(word0=int(bus.ReadDoubleWord(0x10000000)), word1=int(bus.ReadDoubleWord(0x10000004)), complete=int(bus.ReadDoubleWord(0x10000008))),f); f.close()"
quit

{
  "format": "chipsim-design",
  "version": 1,
  "id": "picorv32-fixture",
  "name": "Firmware to PicoRV32 MMIO fixture",
  "tasks": {
    "firmware": {
      "adapter": "firmware",
      "inputs": ["main.c", "start.S"],
      "options": {
        "linker": "link.ld",
        "flags": [
          "-march=rv32i",
          "-mabi=ilp32",
          "-nostdlib",
          "-nostartfiles",
          "-ffreestanding",
          "-O2"
        ]
      },
      "outputs": [
        {
          "path": "out/firmware.elf",
          "kind": "firmware"
        },
        {
          "path": "out/firmware.hex",
          "kind": "memory-image",
          "format": "verilog-byte-hex"
        }
      ]
    },
    "soc": {
      "adapter": "hdl",
      "options": {
        "project": "sim.project.json",
        "debug": false
      },
      "bindings": [
        {
          "task": "firmware",
          "output": "out/firmware.hex",
          "path": "firmware.hex"
        }
      ],
      "outputs": [
        {
          "path": "out/waveform.json",
          "kind": "waveform"
        }
      ]
    },
    "renode": {
      "adapter": "renode",
      "inputs": ["platform.repl"],
      "options": {
        "script": "run.resc"
      },
      "bindings": [
        {
          "task": "firmware",
          "output": "out/firmware.elf",
          "path": "firmware.elf"
        }
      ],
      "checks": [
        {
          "name": "complete",
          "path": "out/mmio.json",
          "field": "complete",
          "operator": "eq",
          "value": 1,
          "scope": "Renode MMIO readback after the firmware completion write"
        },
        {
          "name": "word0",
          "path": "out/mmio.json",
          "field": "word0",
          "operator": "eq",
          "value": 4660,
          "scope": "Renode MMIO readback after the firmware completion write"
        },
        {
          "name": "word1",
          "path": "out/mmio.json",
          "field": "word1",
          "operator": "eq",
          "value": 4661,
          "scope": "Renode MMIO readback after the firmware completion write"
        }
      ]
    }
  },
  "targets": {
    "simulation": {
      "tasks": ["soc"],
      "requiredChecks": ["firmware:outputs", "soc:simulation", "soc:outputs"]
    },
    "firmware": {
      "tasks": ["firmware"],
      "requiredChecks": ["firmware:outputs"]
    },
    "software": {
      "tasks": ["renode"],
      "requiredChecks": [
        "firmware:outputs",
        "renode:execution",
        "renode:complete",
        "renode:word0",
        "renode:word1"
      ]
    }
  }
}

{
  "format": "chipsim-circuit-stimulus",
  "version": 1,
  "duration": 10,
  "events": [
    { "tick": 1, "signal": "clk", "value": 1 },
    { "tick": 1, "signal": "enable", "value": 1 },
    { "tick": 1, "signal": "capture", "value": 1 },
    { "tick": 2, "signal": "clk", "value": 0 },
    { "tick": 3, "signal": "external", "value": 1 },
    { "tick": 3, "signal": "data", "value": 3 },
    { "tick": 3, "signal": "clk", "value": 1 },
    { "tick": 4, "signal": "clk", "value": 0 },
    { "tick": 5, "signal": "reset", "value": 1 },
    { "tick": 6, "signal": "clk", "value": 1 }
  ]
}

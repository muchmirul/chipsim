# Four logical XOR gates from the pinned function table; no analog timing.
model table-efb3cf17b91f-p3-t3
guide 74hc86-nexperia-74hc86 3 "Quad 2-input EXCLUSIVE-OR gate"
expect signal.pin_1y == 0
drive pin_1a 1
expect signal.pin_1y == 1
drive pin_1b 1
expect signal.pin_1y == 0
drive pin_1a 0
expect signal.pin_1y == 1
drive pin_1b 0
expect signal.pin_1y == 0
expect signal.pin_2y == 0
halt

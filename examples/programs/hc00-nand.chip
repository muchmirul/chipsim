# Four logical NAND gates from the pinned function table; no analog timing.
model table-dd401970bc05-p3-t3
guide 74hc00-nexperia-74hc00 3 "Quad 2-input NAND gate"
expect signal.pin_1y == 1
drive pin_1a 1
expect signal.pin_1y == 1
drive pin_1b 1
expect signal.pin_1y == 0
drive pin_1a 0
expect signal.pin_1y == 1
drive pin_1b 0
expect signal.pin_1y == 1
expect signal.pin_2y == 1
halt

{
  "name": "chipsim",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "TUI hardware behavior workbench with headless tools for coding agents",
  "keywords": [
    "pi-package",
    "hardware",
    "simulation"
  ],
  "pi": {
    "extensions": [
      "./extensions/chipsim.ts"
    ]
  },
  "files": [
    "extensions/",
    "src/",
    "scripts/",
    "docs/",
    "models/",
    "examples/",
    "AGENTS.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node scripts/chipsim.mjs",
    "dev": "node scripts/chipsim.mjs",
    "test": "node --test test/*.test.js",
    "verify": "node scripts/verify.mjs",
    "extract": "node scripts/extract.mjs",
    "model": "node scripts/model.mjs",
    "format": "prettier --write src extensions scripts test models examples package.json '*.md' 'docs/*.md'",
    "tui": "node scripts/chipsim.mjs",
    "test:tui": "python3 scripts/test-tui-pty.py && python3 scripts/test-agent-extension-pty.py",
    "test:hdl": "node scripts/test-hdl.mjs",
    "test:hdl-debug": "node scripts/test-hdl-debug.mjs",
    "test:eda": "node scripts/test-eda.mjs",
    "test:physical": "node scripts/test-physical.mjs",
    "test:dwfv": "node scripts/verify-dwfv.mjs",
    "document": "node scripts/document.mjs",
    "agent": "node scripts/agent.mjs",
    "test:install": "node scripts/test-install.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  },
  "bin": {
    "chipsim": "scripts/chipsim.mjs"
  }
}

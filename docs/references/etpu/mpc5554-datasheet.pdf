         <dc:format>application/pdf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">This document provides electrical specifications, pin assignments, and package diagrams for the MPC5554MPC5553MPC5565MPC5567MPC5566Lance microcontroller device. For functional characteristics, refer to the MPC5553/MPC5554MPC5566MPC5565MPC5567Lance Microcontroller Reference Manual. </rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">MPC5566DS: MPC5566 Microcontroller Data Shet</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
